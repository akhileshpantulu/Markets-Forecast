# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Node / web
node_modules/
web/dist/
web/public/pyodide/

# Local scratch
.DS_Store
*.tmp

# ---------------------------------------------------------------------------
# LICENSED DATA GUARD
# The repository is currently PUBLIC (checked 2026-11-06 via the GitHub search
# API). CoStar data, and anything derived row-for-row from it, must not be
# committed while that is true. These rules keep raw uploads, processed data
# and run outputs out of git. Remove this block only after the repository is
# private AND config/hosting.yaml says repo_private: true.
# tests/test_repo_guard.py enforces the same rule in CI.
# ---------------------------------------------------------------------------
inbox/**
!inbox/**/
!inbox/**/.gitkeep
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep
runs/**
!runs/.gitkeep
web/dist-single/
